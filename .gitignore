# Local results (generated)
results/*
!results/.gitkeep
# Small Version 3 review snapshots are intentionally committed so planner
# semantics and closeout evidence can be inspected directly on GitHub.
!results/v3_review/
!results/v3_review/**
# V4.0 geometry-core smoke is the authorized non-inferential kernel check.
!results/v4_review/
!results/v4_review/v4_0_kinematic_geometry_core/
!results/v4_review/v4_0_kinematic_geometry_core/**
!results/v4_review/v4_1_planar2r_geometry_atlas/
!results/v4_review/v4_1_planar2r_geometry_atlas/**
