!results/v4_review/v4_2_span_controlled_geometry_atlas/
!results/v4_review/v4_2_span_controlled_geometry_atlas/**
# GitHub rejects files over 100 MiB; the 138 MiB sample bank stays local.
results/v4_review/v4_2_span_controlled_geometry_atlas/geometry_samples.jsonl
# V4.2A span-controlled visual planning audit closeout (V4-210–V4-219).
!results/v4_review/v4_2a_span_controlled_visual_audit/
!results/v4_review/v4_2a_span_controlled_visual_audit/**
# V4.2B span-controlled corrective closeout (V4-220–V4-229).
!results/v4_review/v4_2b_span_controlled_corrective_closeout/
!results/v4_review/v4_2b_span_controlled_corrective_closeout/**
# V3.6D canonical span corpus closeout (authorized V3-650–V3-659).
!results/v3_review/v3_6d_span_corpus/
!results/v3_review/v3_6d_span_corpus/**
# V3.6E gravity-free wrench math fixtures.
!results/v3_review/v3_6e_static_wrench_core/
!results/v3_review/v3_6e_static_wrench_core/**
# V3.6F 17-case wrench atlas.
!results/v3_review/v3_6f_static_wrench_atlas/
